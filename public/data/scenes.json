      "title": "Suspeitos",
      "light": "steady",
      "character": null,
      "text": "Cinco pessoas tinham acesso ao arquivo a noite: o Delegado, o Escrivao, a Detetive Silva, o Tecnico de TI e o Faxineiro. Quem voce interroga?",
      "choices": [
        { "label": "Interrogar o Delegado", "skill": "Persuasao", "dc": 9, "next": "s5_delegado", "clue": null },
        { "label": "Interrogar o Escrivao", "skill": "Intuicao", "dc": 8, "next": "s6_escrivao", "clue": null },

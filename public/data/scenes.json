      "title": "Arquivo",
      "light": "flicker",
      "character": null,
      "text": "Estantes tombadas. Pastas espalhadas. Um monte de cinzas no centro da sala. Alguns documentos sobreviveram, queimados nas bordas. Um cofre de aco esta entreaberto.",
      "choices": [
        { "label": "Examinar as cinzas", "skill": "Investigacao", "dc": 9, "next": "s3_burned", "clue": "cinzas_recentes" },
        { "label": "Tentar abrir o cofre antigo", "skill": "Tecnologia", "dc": 10, "puzzle": "safeCracker", "next": "s3_burned", "clue": "cofre_aberto" },
        { "label": "Ler documentos sobreviventes", "skill": "Percepcao", "dc": 8, "next": "s3_burned", "clue": "docs_sobreviventes" }
      ]
    },
    {

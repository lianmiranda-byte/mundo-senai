  "scenes": [
    {
      "id": "s0_intro",
      "title": "Chegada",
      "light": "off",
      "character": null,
      "text": "A delegacia esta vazia. As luzes falharam. So o brilho da sua lanterna corta a escuridao. No chao, marcas de sapatos recentes levam ao arquivo. O cheiro de papel queimado ainda paira no ar.",
      "choices": [
        { "label": "Seguir as marcas ate o arquivo", "skill": "Percepcao", "dc": 8, "next": "s1_hall", "clue": "marcas_sapato" },
        { "label": "Examinar a entrada primeiro", "skill": "Investigacao", "dc": 8, "next": "s1_hall", "clue": "entrada_forcada" }
      ]
    },
    {
      "id": "s1_hall",
      "title": "Corredor",
      "light": "off",
      "character": null,
      "text": "O corredor esta escuro. Portas fechadas. Uma delas tem arranhoes recentes, como se algo tivesse sido arrastado. Um extintor esta fora do lugar.",
      "choices": [
        { "label": "Forcar a porta arranhada", "skill": "Forca", "dc": 9, "next": "s2_archive", "clue": "porta_aberta" },
        { "label": "Procurar outra entrada", "skill": "Furtividade", "dc": 8, "next": "s2_archive", "clue": "entrada_alternativa" }
      ]
    },
    {
